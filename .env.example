# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=vapt
POSTGRES_PASSWORD=vapt_secure_password
POSTGRES_DB=vapt_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://vapt:vapt_secure_password@db:5432/vapt_db
DATABASE_URL_SYNC=postgresql://vapt:vapt_secure_password@db:5432/vapt_db

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Email (optional Phase 4) ─────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=changeme
SMTP_FROM=vapt-platform@example.com

# ── Scanner timeouts (seconds) ───────────────────────────────────────────────
NMAP_TIMEOUT=300
ZAP_TIMEOUT=1800
TRIVY_TIMEOUT=600
SEMGREP_TIMEOUT=600

# ── Resource limits ──────────────────────────────────────────────────────────
SCANNER_MEMORY_LIMIT=1g
SCANNER_CPU_LIMIT=1.0

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# ── Reports ──────────────────────────────────────────────────────────────────
REPORTS_DIR=/app/reports
